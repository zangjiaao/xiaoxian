{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaoxian",
  "main": "worker/index.ts",
  // 关掉 workers.dev 和版本预览地址。自定义域名在仪表盘绑定，这里不要写 routes：
  // 不写时 deploy 不会动仪表盘上的域名；写了才会用这份配置覆盖。
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaoxian",
      "database_id": "f942d4b1-4e51-4eac-8211-47969b7d8be3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-chat",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    // 只填团队源站。末尾斜杠或 /cdn-cgi/access/certs 会被去掉，JWT iss 用这个源站。
    "ACCESS_TEAM_DOMAIN": "https://delicate-bread-c32c.cloudflareaccess.com",
    "ACCESS_AUD": "e61f50710d4f19146378ee99a7bc7b4de5767884ad7da18c09aa394d20262631",
    // 只在本机 Host（localhost / 127.0.0.1）上跳过 Access JWT。生产保持空字符串。
    // 本地可在 .dev.vars 里覆盖，例如 DEV_USER_EMAIL=you@example.com
    "DEV_USER_EMAIL": ""
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"]
  }
}
