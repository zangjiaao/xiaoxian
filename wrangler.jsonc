{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaoxian",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaoxian",
      // 跑 `wrangler d1 create xiaoxian` 后，把这里换成输出的 UUID。
      // 这个占位符只够本地 `wrangler dev` 和 `migrations apply --local` 使用。
      "database_id": "11111111-1111-4111-8111-111111111111",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-chat",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    // 部署前改成 https://<team>.cloudflareaccess.com 。留空时，非本机请求一律 401。
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // 只在本机 Host（localhost / 127.0.0.1）上跳过 Access JWT。生产保持空字符串。
    // 本地可在 .dev.vars 里覆盖，例如 DEV_USER_EMAIL=you@example.com
    "DEV_USER_EMAIL": ""
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"]
  }
}
