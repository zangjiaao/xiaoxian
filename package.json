{
  "name": "xiaoxian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 43123 --strictPort",
    "smoke": "node --experimental-strip-types src/lib/chart.smoke.ts && node --experimental-strip-types worker/access.smoke.ts",
    "smoke:api": "node scripts/api-smoke.mjs",
    "cf:dev": "wrangler dev",
    "cf:types": "wrangler types worker/env.d.ts --strict-vars false --include-runtime true",
    "cf:migrate:local": "wrangler d1 migrations apply xiaoxian --local",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/generate-icons.mjs"
  },
  "browserslist": [
    "chrome >= 123",
    "firefox >= 120",
    "safari >= 17.5",
    "edge >= 123",
    "not dead"
  ],
  "dependencies": {
    "@astryxdesign/core": "^0.7.1",
    "@astryxdesign/theme-neutral": "^0.7.1",
    "@stylexjs/stylex": "^0.19.1",
    "dexie": "^4.4.6",
    "jose": "^6.2.13",
    "lunar-typescript": "^1.8.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.7.1",
    "@astryxdesign/cli": "^0.7.1",
    "@babel/core": "^7.28.5",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.151.3"
  }
}
